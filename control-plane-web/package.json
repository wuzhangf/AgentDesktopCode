{
  "name": "@business/control-plane-web",
  "version": "0.2.0",
  "private": true,
  "description": "React agent operations control plane - read-only observation API + SPA",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "node server/main.mjs",
    "dev:all": "node scripts/dev-all.mjs",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "check-source": "node scripts/check-source.mjs",
    "generate-demo": "node scripts/generate-demo.mjs",
    "worker:build": "node scripts/worker-build.mjs",
    "worker:fixture": "python scripts/worker-fixture.py",
    "worker:native-smoke": "node scripts/native-worker-smoke.mjs",
    "worker:serve": "node .local/worker-server/worker-server.mjs",
    "mgmt:build": "node scripts/management-build.mjs",
    "mgmt:package": "node scripts/package-personal-runtime.mjs",
    "mgmt:serve": "node .local/management-server/management-server.mjs",
    "management:build": "node scripts/management-build.mjs",
    "management:serve": "node .local/management-server/management-server.mjs",
    "management:dev": "node scripts/management-build.mjs && node .local/management-server/management-server.mjs",
    "e2e:install": "playwright install chromium",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report .local/playwright-report"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.103.1",
    "decimal.js": "^10.6.0",
    "echarts": "^6.1.0",
    "lucide-react": "^1.47.0",
    "motion": "^13.4.0",
    "qrcode": "1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.1",
    "@types/qrcode": "1.5.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^30.1.0",
    "typescript": "5.9.3",
    "vite": "^7.1.2",
    "vitest": "^3.2.7"
  }
}
