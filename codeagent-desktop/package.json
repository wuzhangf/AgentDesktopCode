{
  "name": "@business/codeagent-desktop",
  "version": "0.0.1",
  "private": true,
  "description": "CodeAgent Desktop (Electron) - EW0 security spike",
  "type": "commonjs",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24.18.0"
  },
  "main": "dist-electron/electron/main/main.js",
  "scripts": {
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.preload.json --noEmit && tsc -p tsconfig.tests.json && tsc -p tsconfig.renderer.json --noEmit",
    "build:main": "tsc -p tsconfig.main.json",
    "build:preload": "tsc -p tsconfig.preload.json",
    "build:renderer": "vite build",
    "build": "tsc -p tsconfig.main.json && tsc -p tsconfig.preload.json && vite build",
    "test": "vitest run",
    "gen:protocol": "node scripts/generate-protocol.mjs",
    "apply:fuses": "node build/apply-fuses.mjs",
    "start": "electron .",
    "e2e:mac": "node scripts/mac-native-electron-e2e.mjs"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@playwright/test": "1.64.0",
    "@tanstack/react-query": "5.102.8",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.10.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@xterm/addon-fit": "0.10.0",
    "@xterm/xterm": "5.5.0",
    "electron": "44.0.0",
    "jsdom": "30.0.1",
    "openapi-typescript": "7.13.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "yaml": "2.9.0"
  }
}
