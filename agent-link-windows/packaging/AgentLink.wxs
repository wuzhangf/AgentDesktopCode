<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Agent Link" Manufacturer="Steercrew" Version="0.1.4"
           Scope="perUser" UpgradeCode="14F93887-700E-43C5-84BF-55266AA93529">
    <MediaTemplate EmbedCab="yes" />
    <Icon Id="AgentLink.ico" SourceFile="$(IconFile)" />
    <Property Id="ARPPRODUCTICON" Value="AgentLink.ico" />
    <MajorUpgrade DowngradeErrorMessage="A newer version of Agent Link is already installed." />
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="Programs" Name="Programs">
        <Directory Id="Steercrew" Name="Steercrew">
          <Directory Id="INSTALLFOLDER" Name="AgentLink" />
        </Directory>
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuAndStartup" Guid="48BDB702-E991-4B03-9B15-CF3E71C47FF1">
        <Shortcut Id="AgentLinkStart" Name="Agent Link" Target="[INSTALLFOLDER]AgentLink.exe"
                  WorkingDirectory="INSTALLFOLDER" Icon="AgentLink.ico" IconIndex="0" />
        <RegistryValue Root="HKCU" Key="Software\Steercrew\AgentLink" Name="Installed"
                       Type="integer" Value="1" KeyPath="yes" />
        <RegistryValue Root="HKCU" Key="Software\Microsoft\Windows\CurrentVersion\Run"
                       Name="Steercrew.AgentLink" Type="string" Value="&quot;[INSTALLFOLDER]AgentLink.exe&quot; --background" />
      </Component>
    </StandardDirectory>
    <Feature Id="AgentLink" Title="Agent Link">
      <ComponentGroupRef Id="Application" />
      <ComponentRef Id="StartMenuAndStartup" />
    </Feature>
  </Package>
  <Fragment>
    <ComponentGroup Id="Application" Directory="INSTALLFOLDER">
      <Files Include="$(Payload)\**" />
    </ComponentGroup>
  </Fragment>
</Wix>
