<Window x:Class="AgentLink.LinkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Agent Link" Width="360" MaxHeight="550" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        ShowInTaskbar="False" Topmost="True" Background="Transparent" FontSize="13"
        FontFamily="Segoe UI Variable, Segoe UI, Microsoft YaHei UI"
        Foreground="{DynamicResource LinkText}" Icon="Assets/AgentLink.ico">
    <Window.Resources>
      <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="Assets/Brand.xaml"/>
        </ResourceDictionary.MergedDictionaries>
        <SolidColorBrush x:Key="LinkSurface" Color="#FCFCFD"/>
        <SolidColorBrush x:Key="LinkText" Color="#17202E"/>
        <SolidColorBrush x:Key="LinkSecondary" Color="#536071"/>
        <SolidColorBrush x:Key="LinkLine" Color="#DFE4EB"/>
        <SolidColorBrush x:Key="LinkSubtle" Color="#EDF1F6"/>
        <SolidColorBrush x:Key="LinkHover" Color="#E4EBF4"/>
        <SolidColorBrush x:Key="LinkAccent" Color="#0863CD"/>
        <SolidColorBrush x:Key="LinkOnAccent" Color="White"/>
        <SolidColorBrush x:Key="LinkReady" Color="#13764E"/>
        <Style x:Key="SecondaryText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource LinkSecondary}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="11,6"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Background" Value="{DynamicResource LinkSubtle}"/>
            <Setter Property="Foreground" Value="{DynamicResource LinkText}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonFace" CornerRadius="7" Background="{TemplateBinding Background}"
                                BorderBrush="Transparent" BorderThickness="1">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonFace" Property="BorderBrush" Value="{DynamicResource LinkSecondary}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonFace" Property="Opacity" Value=".72"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonFace" Property="Opacity" Value=".45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource LinkAccent}"/>
            <Setter Property="Foreground" Value="{DynamicResource LinkOnAccent}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="MinHeight" Value="38"/>
        </Style>
        <Style x:Key="Segment" TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource LinkSecondary}"/>
            <Setter Property="Padding" Value="23,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="SegmentFace" CornerRadius="6" Padding="{TemplateBinding Padding}"
                                Margin="2" BorderThickness="1" BorderBrush="Transparent" Background="Transparent">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource LinkText}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter TargetName="SegmentFace" Property="Background" Value="{DynamicResource LinkSurface}"/>
                                <Setter TargetName="SegmentFace" Property="BorderBrush" Value="{DynamicResource LinkLine}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsSelected" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="SegmentFace" Property="Background" Value="{DynamicResource LinkHover}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Switch" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource LinkSecondary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <ContentPresenter VerticalAlignment="Center" Margin="0,0,8,0" RecognizesAccessKey="True"/>
                            <Border x:Name="Track" Width="34" Height="19" CornerRadius="10"
                                    Background="{DynamicResource LinkSubtle}" BorderThickness="1"
                                    BorderBrush="{DynamicResource LinkSecondary}">
                                <Ellipse x:Name="Knob" Width="11" Height="11" Fill="{DynamicResource LinkSecondary}"
                                         HorizontalAlignment="Left" Margin="3,0"/>
                            </Border>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource LinkAccent}"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource LinkAccent}"/>
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource LinkOnAccent}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Track" Property="Opacity" Value=".45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
      </ResourceDictionary>
    </Window.Resources>
    <Border CornerRadius="13" BorderBrush="{DynamicResource LinkLine}" BorderThickness="1"
            Background="{DynamicResource LinkSurface}" Padding="16,14" Margin="4">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity=".25" ShadowDepth="1" BlurRadius="7"/>
        </Border.Effect>
        <DockPanel>
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                <DockPanel LastChildFill="True">
                    <CheckBox DockPanel.Dock="Right" x:Name="PhoneEnabled" Content="手机连接"
                              AutomationProperties.Name="允许手机连接" Style="{StaticResource Switch}"
                              VerticalAlignment="Center" IsEnabled="False" Click="ConnectionSwitch_Click"/>
                    <StackPanel Orientation="Horizontal">
                        <Image Width="28" Height="28" Margin="0,0,8,0" Source="{StaticResource BrandMark}"
                               AutomationProperties.Name="Agent Link"/>
                        <TextBlock Text="Agent Link" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </DockPanel>
                <StackPanel Orientation="Horizontal" Margin="1,7,0,0">
                    <Ellipse x:Name="StatusDot" Fill="{DynamicResource LinkSecondary}" Width="6" Height="6"
                             VerticalAlignment="Center" Margin="0,0,7,0"/>
                    <TextBlock x:Name="Summary" Text="正在启动" Style="{StaticResource SecondaryText}"
                               AutomationProperties.LiveSetting="Polite"/>
                </StackPanel>
            </StackPanel>
            <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                <Button DockPanel.Dock="Right" Content="设置" Click="Settings_Click"
                        Background="Transparent" MinHeight="28" Padding="8,2"/>
                <TextBlock x:Name="Address" Text="局域网连接" Style="{StaticResource SecondaryText}" FontSize="11"
                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" VerticalAlignment="Center"/>
            </DockPanel>
            <TabControl x:Name="Tabs" KeyboardNavigation.TabNavigation="Local" SelectionChanged="Tabs_SelectionChanged">
                <TabControl.Template>
                    <ControlTemplate TargetType="TabControl">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Background="{DynamicResource LinkSubtle}" CornerRadius="8"
                                    HorizontalAlignment="Left" Margin="0,0,0,10">
                                <TabPanel IsItemsHost="True"/>
                            </Border>
                            <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/>
                        </DockPanel>
                    </ControlTemplate>
                </TabControl.Template>
                <TabItem Header="连接" Style="{StaticResource Segment}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <Border Padding="11" Background="{DynamicResource LinkSubtle}" CornerRadius="8">
                                <DockPanel LastChildFill="True">
                                    <Viewbox DockPanel.Dock="Left" Width="20" Height="20" Margin="0,0,11,0"
                                             AutomationProperties.Name="电脑">
                                        <Path Data="M3,4 H21 V16 H3 Z M12,16 V21 M7,21 H17" StrokeThickness="1.5"
                                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Stroke="{DynamicResource LinkSecondary}"/>
                                    </Viewbox>
                                    <StackPanel>
                                        <TextBlock x:Name="Computer" Text="这台电脑" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="Devices" Text="已配对手机" Style="{StaticResource SecondaryText}"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Button x:Name="Invite" Content="连接手机" Style="{StaticResource PrimaryButton}"
                                    Click="Invite_Click" IsEnabled="False" Margin="0,10,0,0"/>
                            <Border x:Name="QrCard" Background="White" CornerRadius="8" Padding="6"
                                    Margin="0,10,0,0" HorizontalAlignment="Center" Visibility="Collapsed">
                                <Image x:Name="Qr" Width="204" Height="204"
                                       RenderOptions.BitmapScalingMode="NearestNeighbor" AutomationProperties.Name="手机配对二维码"/>
                            </Border>
                            <TextBlock x:Name="InviteHelp" Style="{StaticResource SecondaryText}" Margin="0,5,0,0"/>
                            <StackPanel x:Name="PairingRequests"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="Agent" Style="{StaticResource Segment}">
                    <StackPanel>
                        <Border Padding="11" Background="{DynamicResource LinkSubtle}" CornerRadius="8">
                            <TextBlock x:Name="Agents" Text="正在读取任务来源" TextWrapping="Wrap"/>
                        </Border>
                        <Button Content="接入已运行的 Worker…" Click="ConnectWorker_Click" Margin="0,10,0,0"/>
                        <TextBlock x:Name="WorkerNotice" Style="{StaticResource SecondaryText}" Margin="0,6,0,0"/>
                    </StackPanel>
                </TabItem>
                <TabItem x:Name="Settings" Header="设置" Visibility="Collapsed" Style="{StaticResource Segment}">
                    <StackPanel>
                        <TextBlock Text="设置" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <Border Padding="11" Background="{DynamicResource LinkSubtle}" CornerRadius="8">
                            <CheckBox x:Name="Autostart" Click="Autostart_Click" Content="登录 Windows 后自动启动"
                                      Style="{StaticResource Switch}"/>
                        </Border>
                        <TextBlock x:Name="StartupNotice" Style="{StaticResource SecondaryText}" Margin="0,8,0,0"/>
                    </StackPanel>
                </TabItem>
            </TabControl>
        </DockPanel>
    </Border>
</Window>
