<Window x:Class="AgentLink.LinkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Agent Link" Width="370" Height="530" ResizeMode="CanMinimize"
        ShowInTaskbar="True" WindowStartupLocation="Manual" FontSize="13"
        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
        Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
            <Setter Property="MinHeight" Value="32"/>
        </Style>
    </Window.Resources>
    <DockPanel Margin="16" LastChildFill="True">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="Agent Link" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock x:Name="Summary" Text="正在启动" Margin="0,6,0,0" TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Polite"/>
        </StackPanel>
        <TabControl x:Name="Tabs">
            <TabItem Header="连接">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="10">
                        <TextBlock x:Name="Address" TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <TextBlock x:Name="Devices" Text="已配对手机" FontWeight="SemiBold"/>
                        <CheckBox x:Name="PhoneEnabled" Content="允许手机连接" Margin="0,10,0,3"
                                  Click="ConnectionSwitch_Click" IsEnabled="False"/>
                        <Button x:Name="Invite" Content="连接手机" Click="Invite_Click" IsEnabled="False"/>
                        <Image x:Name="Qr" Width="238" Height="238" Margin="0,8,0,0" Visibility="Collapsed"
                               RenderOptions.BitmapScalingMode="NearestNeighbor" AutomationProperties.Name="手机配对二维码"/>
                        <TextBlock x:Name="InviteHelp" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        <StackPanel x:Name="PairingRequests" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Agent">
                <StackPanel Margin="10">
                    <TextBlock x:Name="Agents" Text="正在读取任务来源" TextWrapping="Wrap"/>
                    <Button Content="刷新 Agent" Click="RefreshAgents_Click"/>
                    <Button Content="接入已运行的 Worker…" Click="ConnectWorker_Click"/>
                    <TextBlock x:Name="WorkerNotice" TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>
            </TabItem>
            <TabItem x:Name="Settings" Header="设置">
                <StackPanel Margin="10">
                    <CheckBox x:Name="Autostart" Click="Autostart_Click" Content="登录 Windows 后自动启动"/>
                    <TextBlock x:Name="StartupNotice" TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
