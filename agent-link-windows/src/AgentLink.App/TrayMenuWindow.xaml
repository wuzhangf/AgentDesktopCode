<Window x:Class="AgentLink.TrayMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Agent Link 快捷面板" Width="368" MaxHeight="540" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        ShowInTaskbar="False" Topmost="True" Background="Transparent" FontSize="13"
        FontFamily="Segoe UI Variable, Segoe UI, Microsoft YaHei UI"
        Foreground="{DynamicResource LinkText}" Icon="Assets/AgentLink.ico">
    <Window.Resources>
      <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="Assets/Brand.xaml"/>
        </ResourceDictionary.MergedDictionaries>
        <SolidColorBrush x:Key="LinkSurface" Color="#FCFCFD"/>
        <SolidColorBrush x:Key="LinkText" Color="#17202E"/>
        <SolidColorBrush x:Key="LinkSecondary" Color="#536071"/>
        <SolidColorBrush x:Key="LinkLine" Color="#DFE4EB"/>
        <SolidColorBrush x:Key="LinkSubtle" Color="#EDF1F6"/>
        <SolidColorBrush x:Key="LinkHover" Color="#E4EBF4"/>
        <SolidColorBrush x:Key="LinkAccent" Color="#0863CD"/>
        <SolidColorBrush x:Key="LinkOnAccent" Color="White"/>
        <SolidColorBrush x:Key="LinkReady" Color="#13764E"/>
        <SolidColorBrush x:Key="LinkWarn" Color="#B3261E"/>
        <Style x:Key="RowButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource LinkText}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Row" CornerRadius="7" Background="{TemplateBinding Background}" Padding="9,7">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" RecognizesAccessKey="False"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource LinkHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Row" Property="Opacity" Value=".7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Row" Property="Opacity" Value=".5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Segment" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource LinkSecondary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="SegmentFace" CornerRadius="6" Margin="2" Padding="6,5" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SegmentFace" Property="Background" Value="{DynamicResource LinkSurface}"/>
                                <Setter Property="Foreground" Value="{DynamicResource LinkText}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
      </ResourceDictionary>
    </Window.Resources>
    <Border CornerRadius="12" BorderBrush="{DynamicResource LinkLine}" BorderThickness="1"
            Background="{DynamicResource LinkSurface}" Margin="4">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity=".25" ShadowDepth="1" BlurRadius="7"/>
        </Border.Effect>
        <DockPanel Margin="10,9,10,6">
            <StackPanel DockPanel.Dock="Top">
                <DockPanel Margin="4,0,2,7">
                    <Button DockPanel.Dock="Right" Content="⚙" FontSize="16" Style="{StaticResource RowButton}"
                            ToolTip="打开配置管理" AutomationProperties.Name="打开配置管理" Click="Main_Click"/>
                    <Image DockPanel.Dock="Left" Width="24" Height="24" Margin="0,0,7,0" Source="{StaticResource BrandMark}"/>
                    <TextBlock Text="Agent Link" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center"/>
                </DockPanel>
                <Border CornerRadius="8" Background="{DynamicResource LinkSubtle}">
                    <UniformGrid Columns="2">
                        <RadioButton x:Name="ConfigTab" Content="配置" GroupName="QuickPage" Style="{StaticResource Segment}"/>
                        <RadioButton x:Name="UsageTab" Content="用量" GroupName="QuickPage" Style="{StaticResource Segment}"/>
                    </UniformGrid>
                </Border>
                <DockPanel x:Name="UsageCaption" Margin="8,8,8,2" Visibility="Collapsed">
                    <ComboBox x:Name="UsageRange" DockPanel.Dock="Right" Width="106" SelectedIndex="0"
                              AutomationProperties.Name="用量时间范围">
                        <ComboBoxItem Content="近 24 小时"/><ComboBoxItem Content="近 7 天"/>
                    </ComboBox>
                    <TextBlock Text="CC Switch 本机记录" Foreground="{DynamicResource LinkSecondary}"
                               FontSize="11" VerticalAlignment="Center"/>
                </DockPanel>
            </StackPanel>
            <StackPanel DockPanel.Dock="Bottom" Margin="0,5,0,0">
                <TextBlock x:Name="Feedback" Visibility="Collapsed" Margin="8,4" TextWrapping="Wrap"
                           Foreground="{DynamicResource LinkWarn}" AutomationProperties.LiveSetting="Polite"/>
                <Border Height="1" Background="{DynamicResource LinkLine}" Margin="0,0,0,3"/>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="退出…" Style="{StaticResource RowButton}" Click="Exit_Click"/>
                    <Button DockPanel.Dock="Right" Content="刷新" Style="{StaticResource RowButton}" Click="Refresh_Click"/>
                    <Button HorizontalContentAlignment="Left" Content="打开主窗口" Style="{StaticResource RowButton}" Click="Main_Click"/>
                </DockPanel>
            </StackPanel>
            <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Padding="0,4">
                <StackPanel x:Name="Rows"/>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
